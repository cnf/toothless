menu "Display Impl: Waveshare Pi 3.5inch (G)"
  config IMPL_DISPLAY_HRES
      int "Display Horizontal Resolution"
      default 480
      help
          Horizontal resolution of the Waveshare 3.5inch RPi display.

  config IMPL_DISPLAY_VRES
      int "Display Vertical Resolution"
      default 320
      help
          Vertical resolution of the Waveshare 3.5inch RPi display.
  config IMPL_DISPLAY_BACKLIGHT_PIN
      int "Backlight Pin"
      default 4
      help
          GPIO pin connected to the display backlight control.

  config IMPL_DISPLAY_SPI_HOST
      int "SPI Host"
      default 1
      help
          SPI host to use for display communication.

  config IMPL_DISPLAY_SPI_CLK_PIN
      int "SPI Clock Pin"
      default 18

  config IMPL_DISPLAY_SPI_MOSI_PIN
      int "SPI MOSI Pin"
      default 23

  config IMPL_DISPLAY_SPI_MISO_PIN
      int "SPI MISO Pin"
      default 19

  config IMPL_DISPLAY_SPI_CS_PIN
      int "Display SPI CS Pin"
      default 5

  config IMPL_DISPLAY_DC_PIN
      int "Display Data/Command Pin"
      default 21

  config IMPL_DISPLAY_RESET_PIN
      int "Display Reset Pin"
      default 22

  config IMPL_DISPLAY_BACKLIGHT_PIN
      int "Display Backlight Pin"
      default 4

  config IMPL_TOUCHPANEL_SPI_CS_PIN
      int "Touchscreen SPI CS Pin"
      default 17

  config IMPL_TOUCHPANEL_INT_PIN
      int "Touchscreen Interrupt Pin"
      default 16

endmenu