#pragma once

#include <esp_err.h>

namespace impl {
inline esp_err_t Setup() {
  ESP_ERROR_CHECK(SetupLvglHardware());
  return ESP_OK;
}
inline esp_err_t SetupLvglHardware() {
  ESP_ERROR_CHECK(PanelInit());
  ESP_ERROR_CHECK(DisplayPanelSetup());
  ESP_ERROR_CHECK(LvgLBufferSetupFull());
  return ESP_OK;
}
}  // namespace impl