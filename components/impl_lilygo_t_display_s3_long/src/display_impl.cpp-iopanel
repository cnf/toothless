void GetDisplayDimensions(uint16_t& width, uint16_t& height) {
  width = kHRes;
  height = kVRes;
}

lv_display_t* GetDisplayObjPtr() { return _display; }

esp_err_t SetupQSPI() {
  spi_bus_config_t buscfg = {
      .data0_io_num = kLcdData0Pin,
      .data1_io_num = kLcdData1Pin,
      .sclk_io_num = kLcdSckPin,
      .data2_io_num = kLcdData2Pin,
      .data3_io_num = kLcdData3Pin,
      .data4_io_num = GPIO_NUM_NC,
      .data5_io_num = GPIO_NUM_NC,
      .data6_io_num = GPIO_NUM_NC,
      .data7_io_num = GPIO_NUM_NC,
      .max_transfer_sz = kMaxTransferSize,  //(SEND_BUF_SIZE * 16) + 8,
      .flags = SPICOMMON_BUSFLAG_MASTER | SPICOMMON_BUSFLAG_GPIO_PINS,
  };
  ESP_ERROR_CHECK(spi_bus_initialize(SPI3_HOST, &buscfg, SPI_DMA_CH_AUTO));
  return ESP_OK;
};

void LvglFlushCallback(lv_display_t* disp, const lv_area_t* area, uint8_t* px_map) {
  FLOG_INFO("Flush......");
  // lv_display_rotation_t rotation = lv_display_get_rotation(disp);
  // lv_area_t rotated_area;
  esp_lcd_panel_handle_t panel_handle = (esp_lcd_panel_handle_t)lv_display_get_user_data(disp);

  int x_start = area->x1;
  int x_end = area->x2;
  int y_start = area->y1;
  int y_end = area->y2;

  int width = lv_area_get_width(area);
  int height = lv_area_get_height(area);
  // lv_draw_sw_rgb565_swap(px_map, width * height);

  // int width = x_end - x_start + 1;   // ADD THE +1!
  // int height = y_end - y_start + 1;  // ADD THE +1!
  // lv_draw_sw_rgb565_swap(px_map, width * height);

  // lv_draw_sw_rgb565_swap(px_map, (x_end + 1 - x_start) * (y_end + 1 - y_start));
  // lv_draw_sw_rgb565_swap(px_map, (area->x2 + 1 - area->x1) * (area->y2 + 1 - area->y1));
  // lv_draw_sw_rgb565_swap(px_map, (area->x2 + 1 - area->x1) * (area->y2 + 1 - area->y1));
  FLOG_INFO("Draw bitmap: x1=%d y1=%d x2=%d y2=%d", x_start, y_start, x_end, y_end);
  // esp_lcd_panel_draw_bitmap(panel_handle, x_start, y_start, x_end + 1, y_end + 1, px_map);
  // draw_bitmap(panel_handle, x_start, y_start, x_end + 1, y_end + 1, px_map);
  // draw_bitmap(panel_handle, x_start, y_start, x_end, y_end, px_map);
  // Now send window as: x1, y1, x1+width-1, y1+height-1
  // This matches what the WORKING code does!
  // draw_bitmap(panel_handle, x_start, y_start, x_start + width - 1, y_start + height - 1, px_map);
  // In LvglFlushCallback - DON'T subtract, just pass coordinates as-is!
  draw_bitmap(panel_handle, x_start, y_start, x_end, y_end, px_map);

  if (lv_display_flush_is_last(_display)) {
    _first_flush_of_frame = true;
    FLOG_INFO("LVGL frame rendered");
  }

  // LcdPushPixels(x1, y1, x2, y2, px_map);

  FLOG_INFO("Draw bitmap done");
  lv_display_flush_ready(disp);
  // lv_bitmap
}

