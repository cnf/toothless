static esp_err_t tx_param(esp_lcd_panel_io_handle_t io, int lcd_cmd, const void* param, size_t param_size) {
  lcd_cmd &= 0xff;
  lcd_cmd <<= 8;
  lcd_cmd |= OPCODE_WRITE_CMD << 24;
  return esp_lcd_panel_io_tx_param(io, lcd_cmd, param, param_size);
}

static esp_err_t tx_color(esp_lcd_panel_io_handle_t io, int lcd_cmd, const void* param, size_t param_size) {
  lcd_cmd &= 0xff;
  lcd_cmd <<= 8;
  lcd_cmd |= OPCODE_WRITE_COLOR << 24;
  // this calls panel_io_spi_tx_color() internally, but that, i think, has the same problem as the send command, it
  // doesn't send the right codes in qspi mode, while this display seems to expect spi commands in qspi mode?
  return esp_lcd_panel_io_tx_color(io, lcd_cmd, param, param_size);
}

static esp_err_t draw_bitmap(esp_lcd_panel_t* panel, int x_start, int y_start, int x_end, int y_end,
                             const void* color_data) {
  assert((x_start < x_end) && (y_start < y_end) && "start position must be smaller than end position");

  size_t width = x_end - x_start + 1;   // Inclusive range
  size_t height = y_end - y_start + 1;  // Inclusive range
  size_t len = width * height * sizeof(lv_color16_t);

  {
    lcd_cmd_t t[2] = {
        {0x2A,
         {(uint8_t)((x_start >> 8) & 0xFF), (uint8_t)(x_start & 0xFF), (uint8_t)((x_end >> 8) & 0xFF),
          (uint8_t)(x_end & 0xFF)},
         0x04},
        {0x2B,
         {(uint8_t)((y_start >> 8) & 0xFF), (uint8_t)(y_start & 0xFF), (uint8_t)((y_end >> 8) & 0xFF),
          (uint8_t)(y_end & 0xFF)},
         0x04},
    };

    // // Subtract 1 from end coordinates (LVGL uses exclusive, display needs inclusive)
    // int x_end_inclusive = x_end - 1;
    // int y_end_inclusive = y_end - 1;

    // lcd_cmd_t t[2] = {
    //     {0x2A,
    //      {(uint8_t)((x_start >> 8) & 0xFF), (uint8_t)(x_start & 0xFF), (uint8_t)((x_end_inclusive >> 8) & 0xFF),
    //       (uint8_t)(x_end_inclusive & 0xFF)},
    //      0x04},
    //     {0x2B,
    //      {(uint8_t)((y_start >> 8) & 0xFF), (uint8_t)(y_start & 0xFF), (uint8_t)((y_end_inclusive >> 8) & 0xFF),
    //       (uint8_t)(y_end_inclusive & 0xFF)},
    //      0x04},
    // };

    tx_param(_io_handle, t[0].addr, t[0].param, t[0].len);
    tx_param(_io_handle, t[1].addr, t[1].param, t[1].len);
    //  LcdSendCmd(t[0].addr, t[0].param, t[0].len);
    // LcdSendCmd(t[1].addr, t[1].param, t[1].len);

    // tx_param(_io_handle, CMD_CASET,
    //          (uint8_t[]){(uint8_t)((x_start >> 8) & 0xFF), (uint8_t)(x_start & 0xFF), (uint8_t)((x_end >> 8) & 0xFF),
    //                      (uint8_t)(x_end & 0xFF)},
    //          4);
    // tx_param(_io_handle, CMD_RASET,
    //          (uint8_t[]){(uint8_t)((y_start >> 8) & 0xFF), (uint8_t)(y_start & 0xFF), (uint8_t)((y_end >> 8) & 0xFF),
    //                      (uint8_t)(y_end & 0xFF)},
    //          4);
  }

  // // define an area of frame memory where MCU can access
  // tx_param(_io_handle, CMD_CASET,
  //          (uint8_t[]){
  //              (x_start >> 8) & 0xFF,
  //              x_start & 0xFF,
  //              ((x_end - 1) >> 8) & 0xFF,
  //              (x_end - 1) & 0xFF,
  //          },
  //          4);

  // tx_param(_io_handle, CMD_RASET,
  //          (uint8_t[]){
  //              (y_start >> 8) & 0xFF,
  //              y_start & 0xFF,
  //              ((y_end - 1) >> 8) & 0xFF,
  //              (y_end - 1) & 0xFF,
  //          },
  //          4);

  // transfer frame buffer
  // size_t len = (x_end - x_start) * (y_end - y_start) * sizeof(lv_color16_t);
  if (_first_flush_of_frame) {
    tx_color(_io_handle, CMD_RAMWR, color_data, len);  // 2C
    _first_flush_of_frame = false;
  } else {
    tx_color(_io_handle, CMD_RAMWRC, color_data, len);  // 3C
  }

  return ESP_OK;
}

