/**
 * Uncomment these line if use custom initialization commands.
 * The array should be declared as static const and positioned outside the function.
 */
// static const axs15231b_lcd_init_cmd_t lcd_init_cmds[] = {
//     //  {cmd, { data }, data_size, delay_ms}
//     {0xFF, (uint8_t[]){0x20, 0x10, 0x10}, 3, 0},
//     {0x0C, (uint8_t[]){0x11}, 1, 0},
//     {0x10, (uint8_t[]){0x02}, 1, 0},
//     {0x11, (uint8_t[]){0x11}, 1, 0},
// };
// cmd, data, size, delay
static const axs15231b_lcd_init_cmd_t lcd_init_cmds[] = {
    {0x28, {0x00}, 0x00, 20},   //<! DISP OFF - Delay 20
    {0x10, {0x00}, 0x00, 200},  //<! SLPIN
    {0x11, {0x00}, 0x00, 20},   //<! SLPOUT - Delay 200
    {0x29, {0x00}, 0x00, 20},   //<! DISP ON
};
typedef struct {
  uint32_t addr;
  uint8_t param[20];
  uint32_t len;
} lcd_cmd_t;

#define delay(ms) vTaskDelay(ms / portTICK_PERIOD_MS)

