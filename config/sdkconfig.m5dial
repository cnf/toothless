CONFIG_IMPL_M5DIAL=y
#CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
#CONFIG_SPIRAM_XIP_FROM_PSRAM is not set

CONFIG_LV_USE_BUILTIN_MALLOC=y
#CONFIG_LV_USE_CLIB_MALLOC=y
#CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="config/partitions8M.csv"
CONFIG_PARTITION_TABLE_FILENAME="config/partitions8M.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y

CONFIG_TL_TC_CLK_PIN=26
CONFIG_TL_TC_CS_PIN=25
CONFIG_TL_TC_MISO_PIN=27

# Needed to drive the display
#CONFIG_SPIRAM=y
#CONFIG_SPIRAM_USE=y
#CONFIG_SPIRAM_USE_MALLOC=y
#CONFIG_SPIRAM_MODE_OCT=y
#CONFIG_SPIRAM_TYPE_AUTO=y
#CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
#CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
#CONFIG_SPIRAM_RODATA=y
#CONFIG_SPIRAM_SPEED_80M=y
#CONFIG_SPIRAM_MEMTEST=y

CONFIG_LV_COLOR_DEPTH_16=y
